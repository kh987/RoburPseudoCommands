<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>Exe</OutputType>
    <LangVersion>7.3</LangVersion>
    <RoburInstallDir Condition="'$(RoburInstallDir)' == ''">C:\Program Files\Topomatic Robur Genplan 16.0</RoburInstallDir>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Lib.Harmony" Version="2.4.2" />
    <Compile Include="..\..\NativePolarPatch.cs" Link="NativePolarPatch.cs" />
    <Compile Include="..\..\NativePolarCandidates.cs" Link="NativePolarCandidates.cs" />
    <Compile Include="..\..\NativePolarRotation.cs" Link="NativePolarRotation.cs" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="Topomatic.Cad.View"><HintPath>$(RoburInstallDir)\Topomatic.Cad.View.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Topomatic.Cad.Foundation"><HintPath>$(RoburInstallDir)\Topomatic.Cad.Foundation.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
</Project>
