{
  "assemblies": {
    "RoburPseudoCommands": {
      "assembly": "RoburPseudoCommands.dll, RoburPseudoCommands.ModulePluginHost"
    }
  },
  "broadcasts": {
    "assembly_loaded": "pseudo_autoload"
  },
  "actions": {
    "id_pseudo_command": {
      "cmd": "pseudo_command",
      "title": "Pseudo command",
      "description": "Run Robur command by alias"
    },
    "id_pseudo_reload_aliases": {
      "cmd": "pseudo_reload_aliases",
      "title": "Reload aliases",
      "description": "Reload aliases.json"
    },
    "id_pseudo_edit_aliases": {
      "cmd": "pseudo_edit_aliases",
      "title": "Псевдокоманды...",
      "description": "Настройка псевдокоманд Robur",
      "icon": "ic_robur_pseudo_commands"
    },
    "id_pseudo_annotation_background_scale": {
      "cmd": "pseudo_annotation_background_scale",
      "title": "Коэффициент фона аннотаций...",
      "description": "Изменить коэффициент перекрытия фона выбранных мультивыносок Robur"
    },
    "id_pseudo_show_log": {
      "cmd": "pseudo_show_log",
      "title": "Show log",
      "description": "Show pseudo command diagnostic log"
    }
  },
  "menubars": {
    "rbproj.service": [
      "id_pseudo_edit_aliases"
    ]
  }
}
